# BidGuard-Agent 环境变量模板
# ─────────────────────────────────────────────────────────────────────────────
# 使用方式：复制本文件为 .env 后按实际环境填写（cp .env.example .env）。
# ⚠️ 安全红线：.env 含真实密钥，已被 .gitignore 排除，严禁提交至 Git 仓库！
#
# 与 .env 的关系：.env 是"本机私密配置"（只放你需要覆盖的项，如真实 API Key）；
# 本文件是"全量变量字典"（模板），覆盖两种运行模式：
#   · 本机直跑模式：Python venv + uvicorn，SQLite 数据库（开发/演示默认）；
#   · 容器编排模式：docker compose 四容器（nginx + app + postgres16 + redis7）。
# 标注【预留】的变量：当前代码尚未消费，为扩展预留，填了也不生效。
# ─────────────────────────────────────────────────────────────────────────────

# ── 1. 大模型网关配置（引擎 F1/F4/F6/F7 消费，对应 config/models.yaml）────────
# 运行档位：demo = 演示环境网关；prod = 企业内网私有网关（标书数据不出域）。
# 不填或填其他值时按 models.yaml 默认档走。用户在网页「私有模型服务配置」绑定
# 个人 Key 后，以用户级配置优先（加密落库，见 user_model_configs 表）。
MODEL_ENV=demo
# 智谱开放平台 API Key（BigModel OpenAI 兼容端点）。不填则引擎走 0 Token 确定性
# 降级模式（F2/F3 全功能，F1/F4/F6 关闭 LLM 层、F7 关键词检索），不会报错中断。
ZHIPU_API_KEY=
# 企业内网私有化网关 Key（MODEL_ENV=prod 时消费；与用户级配置互为兜底）。
PRIVATE_API_KEY=

# ── 2. 安全鉴权（backend/auth.py 消费）───────────────────────────────────────
# 令牌签发密钥（HMAC-SHA256）。生产/公网部署必改：≥32 位随机串。
# 若保留开发默认值，必须同时保持 DEBUG=1 才允许启动（auth.py 启动守卫强制校验）。
AUTH_SECRET=change_me_in_production_at_least_32_chars
# 【预留】跨系统单点登录密钥。BidGuard 当前代码未消费（继承自老项目契约），
# 为将来平台级 SSO 预留；填不填都不影响运行。
SSO_SECRET=change_me_for_platform_sso
# 首次启动初始化 admin 账号的密码（database.py 种子逻辑消费；仅库为空时生效，
# 之后改此项不影响已建库——改密请登录后在页面里操作）。
ADMIN_INITIAL_PASSWORD=ChangeMe123!

# ── 3. 运行模式开关（生产安全相关，本机开发保持默认即可）─────────────────────
# 调试模式开关，默认 '1'（开发/单测兼容）。auth.py 消费：
#   · DEBUG=1：未配 AUTH_SECRET 时用开发默认密钥放行；
#   · DEBUG=0（生产）：未配 AUTH_SECRET 或 AUTH_SECRET 仍是开发默认值 → 拒绝启动。
# 公网部署必须 DEBUG=0 + 独立 AUTH_SECRET 两件套。
DEBUG=1
# 强制 0 Token 确定性模式开关（backend/worker.py 消费）。
# 置 '1' 后即使配了模型 Key 也关闭全部 LLM 调用——用于离线回归测试与成本控制。
# 缺省空 = 跟随 Key 配置自然降级。
BIDGUARD_FORCE_ZERO_TOKEN=
# F4 双阶段并发核验线程池大小（core/response_checker.py 消费，默认 4）。
# 调为 1 即退化为单线程串行；内网网关并发受限时可酌情设为 2 或 4。
BIDGUARD_F4_CONCURRENCY=4
# 交互式 API 文档开关（backend/main.py 消费）：控制 FastAPI 自动生成的
# /docs（Swagger UI 可在线调用）、/redoc 与 /openapi.json 全端点清单是否公开。
# 缺省 '1' = 开发调试友好；生产/公网部署务必置 '0'——关闭后三处返回 404，
# 外人无法借文档枚举接口侦察，业务接口与前端调用完全不受影响。
# 改后需重启进程生效（容器模式 docker compose up -d --force-recreate app）。
ENABLE_API_DOCS=1

# ── 4. 数据库与缓存 ─────────────────────────────────────────────────────────
# 本机直跑默认 SQLite（相对路径自动锚定项目根，WAL 模式）；容器编排模式下由
# docker-compose.yml 注入 postgresql+psycopg2://... 覆盖本值（非 sqlite 直通）。
DATABASE_URL=sqlite:///./data/bidguard.db
# 【预留】Redis 连接串。当前代码零消费（docker-compose 里的 redis 容器为扩展预留：
# 任务队列/向量缓存等后续能力接入时启用），填不填都不影响运行。
REDIS_URL=redis://redis:6379/0

# ── 5. 服务端口、CORS 与运行态（容器编排层消费为主）─────────────────────────
# 【容器编排】nginx 对外映射到宿主机的端口（docker-compose.yml 消费）。
# 与其他项目栈同机共存时改这里避开端口冲突（如 8001），改完 docker compose up -d。
APP_PORT=8000
# 【预留】后端容器内部端口。当前 compose 与 nginx.conf 均按固定 8000 约定，
# 此变量暂未接入模板渲染；改后端端口需同步 Dockerfile CMD 与 nginx upstream。
BACKEND_INTERNAL_PORT=8000
# 跨域白名单（FastAPI CORSMiddleware 消费）。逗号分隔。
# 本机直跑开发=Vite 默认 5173；容器模式=nginx 入口地址（compose 已注入覆盖）。
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:8000
# 后端日志级别（DEBUG/INFO/WARNING/ERROR）。排查问题时临时调 DEBUG。
LOG_LEVEL=INFO
# 演示种子数据开关（database.py 消费）：'1' = 空库首次启动时灌入三部门演示
# 租户/用户/规则；已有数据的库不受影响。生产环境置 '0'。
SEED_DEMO_DATA=1
# 【预留】登录页演示账号一键填充开关。继承自老项目，BidGuard 当前前端未消费
# （登录页演示填充常显）；接入开关逻辑后此变量生效。
SHOW_DEMO_LOGIN=1
