# ==============================================================================
# BidGuard-Agent · Docker 四容器编排环境变量模板
# 使用方式：
#   在项目根目录执行：cp deploy/.env.docker.example .env
#   按实际环境修改密码与模型密钥后执行：docker compose up -d --build
#   ⚠️ 安全红线：严禁将包含真实密钥或生产密码的 .env 文件提交至 Git 仓库！
# ==============================================================================

# ── 1. PostgreSQL 16 数据库容器账密配置 ──
# 注意：POSTGRES_PASSWORD 仅在 pgdata 卷首次初始化（initdb）时生效；
# 若已有旧 pgdata 卷需改密，需先在库内 ALTER USER 或清理旧卷重建。
POSTGRES_USER=bidguard
POSTGRES_PASSWORD=ChangeMe_2026_Str0ng!
POSTGRES_DB=bidguard

# ── 2. 容器时区与对外入口端口 ──
TZ=Asia/Shanghai
# Nginx 容器映射至宿主机的端口（默认 8000，若需直接监听 80 端口可改为 80）
APP_PORT=8000

# ── 3. 鉴权密钥与初始管理员密码（生产部署请务必替换为随机强密钥）──
AUTH_SECRET=ChangeMe_BidGuard_Auth_Secret_2026_Str0ng!
SSO_SECRET=ChangeMe_BidGuard_SSO_Secret_2026_Str0ng!
ADMIN_INITIAL_PASSWORD=BidGuard2026!

# ── 4. 大模型网关配置（对应 config/models.yaml，也可在前端「私有模型服务配置」页按用户绑定）──
MODEL_ENV=demo
ZHIPU_API_KEY=your_api_key_here
PRIVATE_API_KEY=

# ── 5. 应用运行态与种子开关 ──
CORS_ORIGINS=http://localhost:8000,http://127.0.0.1:8000
LOG_LEVEL=INFO
SEED_DEMO_DATA=1
SHOW_DEMO_LOGIN=1

# ── 6. 交互式 API 文档开关（backend/main.py 消费）──
# 控制 FastAPI 自动生成的 /docs（Swagger UI）、/redoc 与 /openapi.json 全端点清单是否公开。
# 生产/公网部署务必置 '0'：关闭后三处返回 404，外人无法借文档枚举接口侦察；
# 业务接口与前端调用完全不受影响。改后需重建容器生效（docker compose up -d --force-recreate app）。
ENABLE_API_DOCS=0